<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Saxophone Heatwave</title>
    <style>
        body, html { margin: 0; padding: 0; width: 100%; height: 100%; background-color: #f4d03f; overflow: hidden; font-family: sans-serif; touch-action: none; user-select: none; }
        #gameCanvas { display: block; width: 100%; height: 100%; }
        #startScreen, #gameOverScreen { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); color: white; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 20px; box-sizing: border-box; z-index: 10; }
        h1 { color: #ffeb3b; margin-bottom: 10px; }
        p { font-size: 1.1em; line-height: 1.5; max-width: 400px; margin: 10px 0; }
        .rules { text-align: left; background: rgba(255,255,255,0.1); padding: 15px; border-radius: 8px; margin-bottom: 20px; }
        button { background: #ff5722; color: white; border: none; padding: 15px 30px; font-size: 1.2em; border-radius: 8px; cursor: pointer; margin-top: 10px; font-weight: bold; width: 80%; max-width: 300px; }
        button:active { transform: scale(0.95); }
        #ui { position: absolute; top: 15px; left: 15px; color: #333; font-weight: bold; font-size: 20px; pointer-events: none; z-index: 5; }
        .hidden { display: none !important; }
    </style>
</head>
<body>
    <div id="ui" class="hidden">Очки: <span id="score">0</span> | Жизни: <span id="lives">3</span></div>
    <canvas id="gameCanvas"></canvas>
    
    <div id="startScreen">
        <h1>Saxophone Heatwave</h1>
        <div class="rules">
            <p><strong>Смысл:</strong> Собери максимум конфет «Melody» во время мемной жары.</p>
            <p><strong>Правила:</strong><br>🍬 Конфеты = +10 очков<br>🔗 Наручники = -1 жизнь<br>👽 Таскены = -1 жизнь</p>
            <p><strong>Управление:</strong> Тапай по левой или правой половине экрана для движения.</p>
        </div>
        <button id="startBtn">Играть</button>
    </div>

    <div id="gameOverScreen" class="hidden">
        <h1>Игра окончена</h1>
        <p>Саксофон заиграл слишком громко...</p>
        <p style="font-size: 1.5em; color: #ffeb3b;">Счет: <span id="finalScore">0</span></p>
        <button id="restartBtn">Повторить</button>
    </div>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const startScreen = document.getElementById('startScreen');
        const gameOverScreen = document.getElementById('gameOverScreen');
        const ui = document.getElementById('ui');
        
        let width, height, player, items, score, lives, isPlaying;

        function resize() {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
            if (player) player.y = height - 80;
        }
        window.addEventListener('resize', resize);
        resize();

        function init() {
            player = { x: width / 2 - 30, y: height - 80, w: 60, h: 60 };
            items = [];
            score = 0;
            lives = 3;
            isPlaying = true;
            document.getElementById('score').textContent = score;
            document.getElementById('lives').textContent = lives;
            spawnItem();
            requestAnimationFrame(update);
        }

        function spawnItem() {
            if (!isPlaying) return;
            const isGood = Math.random() > 0.6;
            const emoji = isGood ? '🍬' : (Math.random() > 0.5 ? '🔗' : '👽');
            items.push({ 
                x: Math.random() * (width - 50), 
                y: -50, w: 50, h: 50, 
                type: isGood ? 'good' : 'bad', 
                emoji: emoji, 
                speed: 3 + Math.random() * 4 + score / 100 
            });
            setTimeout(spawnItem, Math.max(300, 900 - score * 3));
        }

        function update() {
            if (!isPlaying) return;
            ctx.clearRect(0, 0, width, height);

            // Отрисовка игрока
            ctx.fillStyle = '#2196F3';
            ctx.fillRect(player.x, player.y, player.w, player.h);

            // Отрисовка объектов
            ctx.font = '40px Arial';
            for (let i = items.length - 1; i >= 0; i--) {
                let p = items[i];
                p.y += p.speed;
                ctx.fillText(p.emoji, p.x, p.y + p.h - 5);

                // Коллизия
                if (p.x < player.x + player.w && p.x + p.w > player.x && p.y < player.y + player.h && p.y + p.h > player.y) {
                    if (p.type === 'good') { 
                        score += 10; 
                        document.getElementById('score').textContent = score;
                    } else { 
                        lives--; 
                        document.getElementById('lives').textContent = lives;
                    }
                    items.splice(i, 1);
                    if (lives <= 0) return gameOver();
                } else if (p.y > height) {
                    items.splice(i, 1);
                }
            }
            requestAnimationFrame(update);
        }

        function gameOver() {
            isPlaying = false;
            ui.classList.add('hidden');
            gameOverScreen.classList.remove('hidden');
            document.getElementById('finalScore').textContent = score;
        }

        // Управление тапами
        canvas.addEventListener('touchstart', (e) => {
            if (!isPlaying) return;
            const touchX = e.touches[0].clientX;
            player.x = touchX < width / 2 ? Math.max(0, player.x - 50) : Math.min(width - player.w, player.x + 50);
        });

        // Управление кликами для тестов в десктопном браузере
        canvas.addEventListener('mousedown', (e) => {
            if (!isPlaying) return;
            player.x = e.clientX < width / 2 ? Math.max(0, player.x - 50) : Math.min(width - player.w, player.x + 50);
        });

        document.getElementById('startBtn').addEventListener('click', () => {
            startScreen.classList.add('hidden');
            ui.classList.remove('hidden');
            init();
        });

        document.getElementById('restartBtn').addEventListener('click', () => {
            gameOverScreen.classList.add('hidden');
            ui.classList.remove('hidden');
            init();
        });
    </script>
</body>
</html>
